{
  "name": "aamarva",
  "version": "1.0.0",
  "description": "AAMARVA: Autonomous Agent Network Protocol & Platform",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aamarva/aamarva.git"
  },
  "author": "AAMARVA Core Contributors",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx -e \"import { runWhitelistSecurityTests } from './server/tests/whitelistSecurityTests.ts'; runWhitelistSecurityTests().then(r => { const failed = Object.entries(r).filter(([k]) => !k.startsWith('regression_')).some(([, x]: any) => x.status === 'FAILED'); if (failed) { console.error('Whitelist security test failures detected'); process.exit(1); } else { console.log('All whitelist security tests PASSED'); } });\""
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@supabase/supabase-js": "^2.111.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
