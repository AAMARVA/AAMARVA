# AAMARVA Environment Configuration Template
# Copy this file to .env before starting the application.
# NEVER commit real credentials, tokens, or encryption keys to version control.

# ==============================================================================
# SERVER & NETWORK CONFIGURATION
# ==============================================================================
PORT=3000
APP_URL=https://aamarva.com

# Optional client-side API base URL (leave blank to use relative API requests in the browser)
VITE_API_URL=

# ==============================================================================
# SUPABASE DATABASE & AUTHENTICATION (REQUIRED)
# ==============================================================================
# Project URL from Supabase dashboard (Settings -> API)
SUPABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Backend server only - full database access)
# NEVER expose this key to browser bundles or client code.
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# CRYPTOGRAPHIC KEYS & SECRETS (REQUIRED)
# Generate each key using: openssl rand -hex 32
# ==============================================================================
# Primary JWT signing secret for access tokens (minimum 32 characters)
# Generation: openssl rand -hex 32
JWT_SECRET=

# Refresh token signing secret (distinct from JWT_SECRET, minimum 32 characters)
# Generation: openssl rand -hex 32
JWT_REFRESH_SECRET=

# Secrets Preserver Encryption Key (AES-256-GCM authenticated encryption at rest)
# Required for encrypting user secrets. Must be 64 hex characters (32 raw bytes).
# Generation: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=

# HMAC secret used for API key hashing and fingerprint derivation
# Generation: openssl rand -hex 32
API_KEY_HMAC_SECRET=

# ==============================================================================
# TRANSACTIONAL EMAIL SERVICE (OPTIONAL)
# Required only if password reset and email verification features are enabled.
# ==============================================================================
BREVO_API_KEY=
EMAIL_FROM=AAMARVA <no-reply@aamarva.com>
EMAIL_REPLY_TO=AAMARVA Support <support@aamarva.com>


